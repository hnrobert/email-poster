{
  "name": "email-poster",
  "version": "0.3.0",
  "description": "Schema-driven email sending over HTTP POST webhooks (Power Automate / smtogo / Resend-like / custom JSON gateways).",
  "keywords": [
    "email",
    "mail",
    "post",
    "webhook",
    "power-automate",
    "transactional",
    "resend",
    "nodemailer-alternative"
  ],
  "license": "Apache-2.0",
  "author": "hnrobert",
  "repository": {
    "type": "git",
    "url": "https://github.com/hnrobert/email-poster.git"
  },
  "bugs": {
    "url": "https://github.com/hnrobert/email-poster/issues"
  },
  "homepage": "https://github.com/hnrobert/email-poster",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./pure": {
      "types": "./dist/pure.d.ts",
      "import": "./dist/pure.js",
      "require": "./dist/pure.cjs"
    },
    "./vue": {
      "types": "./vue/index.d.ts",
      "import": "./vue/index.ts"
    },
    "./template": {
      "types": "./dist/template.d.ts",
      "import": "./dist/template.js",
      "require": "./dist/template.cjs"
    },
    "./adapters/nuxt": {
      "types": "./dist/adapters/nuxt.d.ts",
      "import": "./dist/adapters/nuxt.js",
      "require": "./dist/adapters/nuxt.cjs"
    },
    "./adapters/nestjs": {
      "types": "./dist/adapters/nestjs.d.ts",
      "import": "./dist/adapters/nestjs.js",
      "require": "./dist/adapters/nestjs.cjs"
    },
    "./adapters/hono": {
      "types": "./dist/adapters/hono.d.ts",
      "import": "./dist/adapters/hono.js",
      "require": "./dist/adapters/hono.cjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "email-poster": "dist/cli.js"
  },
  "files": [
    "dist",
    "vue",
    ".agents",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@11.21.0",
  "sideEffects": [
    "**/*.vue",
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup && pnpm build:vue",
    "build:vue": "vue-tsc -p tsconfig.vue.emit.json && rm -f vue/*.d.ts && cp .vue-dts/*.d.ts vue/ && rm -rf .vue-dts",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit && vue-tsc -p tsconfig.vue.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm build && chmod +x dist/cli.js"
  },
  "dependencies": {
    "zod": "~3.23.8"
  },
  "peerDependencies": {
    "vue": "^3.4"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.1.0"
  }
}
