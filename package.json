{
  "name": "email-poster",
  "version": "0.1.0",
  "description": "Schema-driven email sending over HTTP POST webhooks (Power Automate / smtogo / Resend-like / custom JSON gateways).",
  "keywords": [
    "email",
    "mail",
    "post",
    "webhook",
    "power-automate",
    "transactional",
    "resend",
    "nodemailer-alternative"
  ],
  "license": "Apache-2.0",
  "author": "Robert He",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./template": {
      "types": "./dist/template.d.ts",
      "import": "./dist/template.js",
      "require": "./dist/template.cjs"
    },
    "./adapters/nuxt": {
      "types": "./dist/adapters/nuxt.d.ts",
      "import": "./dist/adapters/nuxt.js",
      "require": "./dist/adapters/nuxt.cjs"
    },
    "./adapters/nestjs": {
      "types": "./dist/adapters/nestjs.d.ts",
      "import": "./dist/adapters/nestjs.js",
      "require": "./dist/adapters/nestjs.cjs"
    },
    "./adapters/hono": {
      "types": "./dist/adapters/hono.d.ts",
      "import": "./dist/adapters/hono.js",
      "require": "./dist/adapters/hono.cjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "email-poster": "./dist/cli.js"
  },
  "files": [
    "dist",
    ".agents",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@11.13.0",
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm build && chmod +x dist/cli.js"
  },
  "dependencies": {
    "zod": "~3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
